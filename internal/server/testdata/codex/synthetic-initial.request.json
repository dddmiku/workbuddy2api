{
  "model": "cn:deepseek-v4.1-flash",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": "Summarize the sample invoices and preserve their identifiers exactly."
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "exec_command",
      "description": "Run a command in the synthetic example workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "workdir": {
            "type": "string"
          }
        },
        "required": [
          "cmd",
          "workdir"
        ],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "reasoning": {
    "effort": "low",
    "summary": "concise"
  },
  "store": false,
  "stream": true,
  "include": [
    "reasoning.encrypted_content"
  ],
  "prompt_cache_key": "synthetic-codex-cache-key",
  "text": {
    "format": {
      "type": "json_schema",
      "name": "codex_output_schema",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "tests_passed": {
            "type": "boolean"
          },
          "first_invoice_id": {
            "type": "string"
          }
        },
        "required": [
          "summary",
          "tests_passed",
          "first_invoice_id"
        ],
        "additionalProperties": false
      }
    }
  }
}
